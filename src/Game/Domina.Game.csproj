<Project Sdk="Godot.NET.Sdk/4.7.0">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Domina.Game</RootNamespace>
  </PropertyGroup>

  <!--
    The Godot layer CONSUMES the core; the core knows nothing of Godot.
    This arrow points one way — no Godot reference goes into Domina.Core or
    Domina.Chat (see CLAUDE.md → "Architecture rule").
  -->
  <ItemGroup>
    <ProjectReference Include="..\Domina.Core\Domina.Core.csproj" />
    <ProjectReference Include="..\Domina.Chat\Domina.Chat.csproj" />
    <ProjectReference Include="..\Domina.Presentation\Domina.Presentation.csproj" />
  </ItemGroup>

</Project>
