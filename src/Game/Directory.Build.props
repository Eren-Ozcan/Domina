<Project>

  <!--
    Deliberately EMPTY and deliberately not importing the Directory.Build.props at
    the root.

    MSBuild searches upward and stops at the FIRST Directory.Build.props it finds.
    Thanks to this file the Godot project does not inherit the root settings
    (TargetFramework, TreatWarningsAsErrors, the analyzer level) — Godot.NET.Sdk sets
    the TargetFramework itself and analyzer warnings in generated code do not turn
    into errors.
  -->

</Project>
