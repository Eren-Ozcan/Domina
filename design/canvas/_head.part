<!doctype html>
<html>
<head>
  <meta charset="utf-8">
  <script src="./support.js"></script>
</head>
<body>
<x-dc>
<helmet>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;600;700&display=swap">
  <style>
    :root {
      --ground: #111215;   /* UiKit.Ground   */
      --surface: #1c1c21;  /* UiKit.Surface  */
      --raised: #25262b;   /* UiKit.Raised   */
      --edge: #383941;     /* UiKit.Edge     */
      --ink: #e0dfd7;      /* UiKit.Ink      */
      --muted: #808188;    /* UiKit.Muted    */
      --heading: #b89e66;  /* UiKit.Heading  */
      --good: #7da878;     /* UiKit.Good     */
      --pending: #ccad5c;  /* UiKit.Pending  */
      --warning: #c26661;  /* UiKit.Warning  */
      --indigo: #5c6ea8;   /* GDD 12 - the player's side  */
      --vermilion: #be3a22;/* GDD 12 - blood and critical only */
    }
    * { box-sizing: border-box; }
    body {
      margin: 0; width: 1920px; height: 1080px; overflow: hidden;
      background: var(--ground); color: var(--ink);
      font-family: "Open Sans", system-ui, sans-serif; font-size: 16px;
    }
    a { color: var(--heading); } a:hover { color: var(--pending); }
    .panel { background: var(--surface); border: 1px solid var(--edge); border-radius: 4px; padding: 12px 14px; }
    .sec { display: flex; align-items: center; gap: 7px; font-size: 14px; color: var(--heading);
           letter-spacing: 0.06em; text-transform: uppercase; }
    .sec::before { content: ""; width: 2px; height: 12px; background: var(--heading); flex: none; }
    .note { font-size: 13px; color: var(--muted); }
    .fig { font-size: 20px; }
    .btn { background: var(--raised); border: 1px solid var(--edge); border-radius: 3px;
           padding: 7px 14px; font-size: 16px; color: var(--ink); text-align: center; }
    .btn.primary { background: #384233; color: var(--good); }
    .btn.danger { background: #2b1917; border-color: #5a2e29; color: var(--warning); }
    .btn.off { background: #1c1c21; color: var(--muted); }
    .rule { height: 1px; background: var(--edge); }
    .chip { min-width: 84px; background: var(--raised); border: 1px solid var(--edge); border-radius: 3px;
            padding: 7px 10px; display: flex; flex-direction: column; gap: 2px; align-items: center; }
    .chip .cap { font-size: 12px; color: var(--muted); text-transform: uppercase; letter-spacing: 0.05em; }
    .chip .trend { font-size: 12px; color: var(--muted); }
    .chip .state { height: 3px; align-self: stretch; }
    .tabs { display: flex; gap: 6px; }
    .tab { padding: 7px 14px; border-radius: 3px 3px 0 0; font-size: 16px; color: var(--muted); }
    .tab.on { background: var(--raised); color: var(--heading); box-shadow: inset 0 -2px 0 var(--heading); }
    .meter { background: #1a1a1f; border-radius: 2px; height: 8px; overflow: hidden; }
    .meter > i { display: block; height: 100%; background: var(--heading); border-radius: 2px; }
    .row { display: flex; }
    .card { background: var(--raised); border: 1px solid var(--edge); border-radius: 3px; padding: 10px 12px; }
  </style>
</helmet>
