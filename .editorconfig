root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{md,yml,yaml,json}]
indent_size = 2

[*.{csproj,props,targets}]
indent_size = 2

[*.cs]
# using layout
dotnet_sort_system_directives_first = true
csharp_using_directive_placement = outside_namespace:warning

# modern C# style
csharp_style_namespace_declarations = file_scoped:warning
csharp_style_var_when_type_is_apparent = true:suggestion
dotnet_style_readonly_field = true:warning
csharp_prefer_braces = true:suggestion

# naming: constants and static readonly fields are exempt from the underscore rule.
# They are declared FIRST because a naming rule only applies to the symbols no earlier
# rule already matched; `severity = none` lets both `PascalCase` and `_camelCase` stand,
# which is what the existing code does. Enforcing one of the two would mean renaming
# about fifty fields.
dotnet_naming_rule.constant_fields_any.symbols = constant_fields
dotnet_naming_rule.constant_fields_any.style = any_name
dotnet_naming_rule.constant_fields_any.severity = none
dotnet_naming_symbols.constant_fields.applicable_kinds = field
dotnet_naming_symbols.constant_fields.applicable_accessibilities = *
dotnet_naming_symbols.constant_fields.required_modifiers = const
dotnet_naming_rule.static_readonly_fields_any.symbols = static_readonly_fields
dotnet_naming_rule.static_readonly_fields_any.style = any_name
dotnet_naming_rule.static_readonly_fields_any.severity = none
dotnet_naming_symbols.static_readonly_fields.applicable_kinds = field
dotnet_naming_symbols.static_readonly_fields.applicable_accessibilities = *
dotnet_naming_symbols.static_readonly_fields.required_modifiers = static,readonly
dotnet_naming_style.any_name.capitalization = camel_case

# naming: the remaining private instance fields are _camelCase
dotnet_naming_rule.private_fields_underscore.symbols = private_fields
dotnet_naming_rule.private_fields_underscore.style = underscore_camel
dotnet_naming_rule.private_fields_underscore.severity = warning
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_style.underscore_camel.required_prefix = _
dotnet_naming_style.underscore_camel.capitalization = camel_case

# code generated by Godot
[src/Game/.godot/**]
generated_code = true
